#!/usr/bin/env python3
"""compose-shader OUT.frag [--window] [--fx FILE.frag PERCENT] [--col FILE.frag PERCENT] [--cur FILE.frag]

Build the one shader Hyprland runs: the effect first, then the colour grade on the effect's result.
Each layer has a strength (0-100). --cur adds a cursor-bend layer (cursor-shaders/; its strength 0-100 blends the bent screen with the plain one): it defines `vec4 bend(vec2 uv)`
(the screen as seen through the effect) and the effect layer's texture(tex, ...) calls go through it, so the effect and
colour are drawn on the bent screen. bin/cursor-bend swaps the line //@CURSOR-CONSTS@ for the live cursor values. A shader that declares `// strength-mode: native` reads the constant
STRENGTH (0.0-1.0) itself; every other shader is blended with its input: mix(input, result, strength).
"""
import os, re, sys

HEADER = re.compile(r'^\s*(#version\b|precision\b|in\s+vec2\s+v_texcoord|uniform\s+sampler2D\s+tex\b|uniform\s+float\s+time\b|layout\s*\(location\s*=\s*0\)\s*out\s+vec4\s+fragColor)')
TYPES = r'(?:const\s+)?(?:float|int|uint|bool|[iu]?vec[234]|mat[234]|void)'


def layer(path, percent, prefix, sample=None):
    src = open(path).read()
    native = re.search(r'^//\s*strength-mode:\s*native\b', src, re.M) is not None
    text = "\n".join(l for l in src.splitlines() if not HEADER.match(l))
    for name in set(re.findall(r'^%s\s+(\w+)\s*[(\[=;]' % TYPES, text, re.M)):
        if name != "main":
            text = re.sub(r'\b%s\b' % re.escape(name), prefix + name, text)
    text = re.sub(r'\bvoid\s+main\s*\(\s*\)', 'void %smain()' % prefix, text, count=1)
    if sample:
        rest = text.replace('texture(tex, v_texcoord)', '')
        if re.search(r'v_texcoord|gl_FragCoord|\btex\b|\btime\b', rest):
            sys.exit("%s: a colour grade may only read texture(tex, v_texcoord)" % path)
        text = text.replace('texture(tex, v_texcoord)', sample)
    s = max(0.0, min(100.0, float(percent))) / 100.0
    text = re.sub(r'\bSTRENGTH\b', prefix + 'S', text)
    return src, "const float %sS = %.4f;\n%s" % (prefix, s, text), native

CUSTOM_RE = re.compile(r'^custom-([0-9a-fA-F]{6})$')


def custom_source(name):
    """GLSL for the custom colour grade `custom-RRGGBB`: shadows go to a dark shade of the colour, mid greys to the
    colour, highlights to a pale tint of it. Luminance is kept, so text stays readable."""
    m = CUSTOM_RE.match(name)
    if not m:
        raise ValueError("not a custom colour name: %s" % name)
    h = m.group(1).lower()
    r, g, b = (int(h[i:i + 2], 16) / 255.0 for i in (0, 2, 4))
    return """#version 300 es
// category: Custom
// strength: 80
// desc: Your own colour #%s: dark shade in the shadows, the colour in the middle, a pale tint in the highlights
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
layout(location = 0) out vec4 fragColor;
void main() {
    vec4 s = texture(tex, v_texcoord);
    float l = dot(s.rgb, vec3(0.299, 0.587, 0.114));
    vec3 t = vec3(%.4f, %.4f, %.4f);
    vec3 lo = t * 0.07;
    vec3 hi = mix(t, vec3(1.0), 0.8);
    vec3 c = l < 0.5 ? mix(lo, t, l * 2.0) : mix(t, hi, (l - 0.5) * 2.0);
    fragColor = vec4(c, s.a);
}
""" % (h, r, g, b)


def custom_file(state_dir, name):
    """Path of the generated shader for a custom colour name (written on first use)."""
    path = os.path.join(state_dir, "custom-colors", name.lower() + ".frag")
    if not os.path.isfile(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + ".tmp", "w") as f:
            f.write(custom_source(name))
        os.replace(path + ".tmp", path)
    return path


CUR_MARK = "//@CURSOR-CONSTS@"
CUR_DEFAULTS = ("const vec2 CUR = vec2(960.0, 540.0);\nconst vec2 CVEL = vec2(0.0, 0.0);\nconst float CT = 99.0;\nconst bool CMARK = false;\n"
                "const vec2 CTR[8] = vec2[8](" + ", ".join(["vec2(960.0, 540.0)"] * 8) + ");")

CUR_PRELUDE = """\
%s
%s
#define RES vec2(textureSize(tex, 0))
bool cur_here = true;
vec4 cur_tex(vec2 uv);
// The pointer trail: cur_pt(0) is the pointer, cur_pt(8) the oldest of 8 earlier positions (about 35 ms apart).
vec2 cur_pt(int i) { return i == 0 ? CUR : CTR[i - 1]; }
// Distance from p to trail segment i (between cur_pt(i), newer, and cur_pt(i + 1), older). dir = unit vector of travel,
// len = segment length, h = 0 at the older end .. 1 at the newer end. A segment with no length gives a huge distance.
float cur_seg(vec2 p, int i, out vec2 dir, out float len, out float h) {
    vec2 a = cur_pt(i), b = cur_pt(i + 1);
    vec2 ab = a - b;
    float l2 = dot(ab, ab);
    dir = vec2(0.0); len = 0.0; h = 0.0;
    if (l2 < 1.0) return 1.0e5;
    len = sqrt(l2);
    dir = ab / len;
    h = clamp(dot(p - b, ab) / l2, 0.0, 1.0);
    return distance(p, b + ab * h);
}
"""

CUR_TAIL = """\
// On several same-size monitors every monitor runs this same shader, so the cursor's monitor is marked by
// three pixels in its top-left corner (magenta, green, magenta) that the shell draws and this code hides again.
bool cur_marked() {
    vec2 px = 1.0 / RES;
    vec3 a = texture(tex, vec2(0.5, 0.5) * px).rgb;
    vec3 b = texture(tex, vec2(1.5, 0.5) * px).rgb;
    vec3 c = texture(tex, vec2(2.5, 0.5) * px).rgb;
    return distance(a, vec3(1.0, 0.0, 1.0)) < 0.2 && distance(b, vec3(0.0, 1.0, 0.0)) < 0.2 && distance(c, vec3(1.0, 0.0, 1.0)) < 0.2;
}
vec4 cur_tex(vec2 uv) {
    vec2 q = uv * RES;
    if (CMARK && q.y < 2.0 && q.x < 3.0) uv = vec2(3.5, 2.5) / RES;
    return cur_here ? mix(texture(tex, uv), %sbend(uv), %sS) : texture(tex, uv);
}
"""


def compose(fx=None, col=None, cur=None, window=False):
    """fx/col/cur are (path, percent) tuples; returns the shader text. window=True builds a per-window shader for
    HyprWindowShade (GLSL ES 3.20, premultiplied alpha taken from the window, so transparent margins stay transparent)."""
    out = ["#version 320 es" if window else "#version 300 es", "// composed: effect %s + colour %s%s" % (fx[0] if fx else "-", col[0] if col else "-", " + cursor " + cur[0] if cur else ""),
           "precision highp float;", "in vec2 v_texcoord;", "uniform sampler2D tex;"]
    fx_src = fx_text = ""
    fx_native = False
    if fx:
        fx_src, fx_text, fx_native = layer(fx[0], fx[1], "fx_")
        if cur:
            fx_text = re.sub(r'\btexture\s*\(\s*tex\s*,', 'cur_tex(', fx_text)
    if re.search(r'^\s*uniform\s+float\s+time\b', fx_src, re.M):
        out.append("uniform float time;")
    out.append("layout(location = 0) out vec4 fragColor;")
    body = ["void main() {"]
    first = "texture(tex, v_texcoord)"
    if cur:
        _, cur_text, _ = layer(cur[0], cur[1], "bd_")
        out.append(CUR_PRELUDE % (CUR_MARK, CUR_DEFAULTS))
        out.append(cur_text)
        out.append(CUR_TAIL % ("bd_", "bd_"))
        body.append("    cur_here = !CMARK || cur_marked();")
        first = "cur_tex(v_texcoord)"
    body += ["    vec4 src0 = %s;" % first, "    fragColor = src0;"]
    if fx:
        out.append(fx_text)
        body.append("    fx_main();")
        if not fx_native:
            body.append("    fragColor = vec4(mix(src0.rgb, fragColor.rgb, fx_S), fragColor.a);")
    out.append("vec4 fx_in;")
    if col:
        _, col_text, col_native = layer(col[0], col[1], "c_", sample="fx_in")
        out.append(col_text)
        body.append("    fx_in = fragColor;")
        body.append("    c_main();")
        if not col_native:
            body.append("    fragColor = vec4(mix(fx_in.rgb, fragColor.rgb, c_S), fragColor.a);")
    if window:
        body.append("    float w_a = texture(tex, v_texcoord).a;")
        body.append("    fragColor = vec4(clamp(fragColor.rgb, 0.0, 1.0) * w_a, w_a);")
    body.append("}")
    return "\n".join(out + body) + "\n"


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit(__doc__)
    out_path = args.pop(0)
    if out_path == "--custom":  # --custom STATE_DIR NAME: print the path of the generated custom colour shader
        print(custom_file(args[0], args[1]))
        return
    fx = col = cur = None
    window = False
    while args:
        flag = args.pop(0)
        if flag == "--window":
            window = True
        elif flag == "--fx":
            fx = (args.pop(0), args.pop(0))
        elif flag == "--col":
            col = (args.pop(0), args.pop(0))
        elif flag == "--cur":
            cur = (args.pop(0), 100)
        else:
            sys.exit(__doc__)
    if not fx and not col and not cur:
        sys.exit(__doc__)
    open(out_path, "w").write(compose(fx, col, cur, window))


if __name__ == "__main__":
    main()
