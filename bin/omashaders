#!/usr/bin/env bash
# omashaders: switch Hyprland full-screen GLSL shaders (all monitors, GPU-side)
# usage: omashaders list [-a] | listall (name, static|animated|motion, category, description, screen|color|mouse; tab separated)
#        | effect [status|list|set NAME|off] | color [status|list|set NAME|off] | mouse [status|list|set NAME|off]
#        | status | set NAME | off | toggle [NAME] | next [-a] | prev [-a] | reapply | animated [on|off|toggle] | gpu
#        | mix effect|color [status|set NAME|off|mode stack|blend|toggle|amount PERCENT|+N|-N|reset] (a second effect/colour mixed into the first)
#        | window [-a CLASS] [status|effect|color|strength|target|classes|apps|apply|load|off|inherit] (same effects/colours on chosen app windows; needs the HyprWindowShade plugin)
#        | window frame [status|list|set NAME|off|reload] (shadow, glow and border presets for all windows: Hyprland's own options, no plugin needed)
#        | perf [status|on|off|report [--days N] [--notify]|bench [--kinds screen,color,wall] [--only A,B]|crashes [--hours N]] (what each effect costs; bin/perf-log)
#        | wallopt react|speed|zoom|range [PERCENT|+N|-N|reset] | wallopt target [RRGGBB] (wallpaper effects: mouse reaction 0-200, speed 0-300, zoom 25-300, Colour reactor range and picked colour)
#        | strength [effect|color [PERCENT|+N|-N|reset]] | power [status|on|off|toggle] [--notify]
# Two screen layers: an effect (shaders/) and a colour grade (colors/). Hyprland runs only one screen
# shader, so with both set they are merged into one (bin/compose-shader): effect first, colour on top.
# `off` turns both layers off; `set NAME` sets the effect (a colour name sets the colour layer instead).
# Each layer has a strength 0-100 (remembered per effect; start value from a `// strength: N` line in the shader).
# `power off` pauses every screen shader without forgetting the choice (bar icon and wallpaper/cursor overlays follow).
# Cursor effects are overlays (mouse-effects/) or, in the Bend category, shaders that bend the real screen
# around the pointer (cursor-shaders/, fed the pointer position by bin/cursor-bend while the shell runs it).
# The cycle is: each effect, then off. Shaders that declare `uniform float time` (animated)
# are skipped unless -a is given: they force Hyprland to redraw the whole screen every frame.
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
DIR="$ROOT/shaders"
CDIR="$ROOT/colors"
MDIR="$ROOT/mouse-effects"
BDIR="$ROOT/cursor-shaders"
FRDIR="$ROOT/frames"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/io.github.akton1.omashaders"
STATE="$STATE_DIR/current"
names() {
  for f in "$DIR"/*.frag; do
    [ -e "$f" ] || continue
    [ "$1" = "-a" ] || ! grep -q 'uniform[[:space:]]\+float[[:space:]]\+time' "$f" || continue
    basename "$f" .frag
  done
}
COLOR_STATE="$STATE_DIR/color"
current() { cat "$STATE" 2>/dev/null; }
current_color() { cat "$COLOR_STATE" 2>/dev/null; }
# path of a colour grade's shader; "custom-RRGGBB" is a colour of your own, generated on first use into the state folder
cfile() {
  case "$1" in
    custom-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) python3 "$ROOT/bin/compose-shader" --custom "$STATE_DIR" "$1" ;;
    *) echo "$CDIR/$1.frag" ;;
  esac
}
color_names() { for f in "$CDIR"/*.frag; do [ -e "$f" ] && basename "$f" .frag; done; }
is_animated() { grep -q 'uniform[[:space:]]\+float[[:space:]]\+time' "$1"; }
# "animated" is a persisted on/off switch for the picker and the cycle; prints 1 or 0 (empty = never set)
animated_flag() { cat "$STATE_DIR/animated" 2>/dev/null; }
# gpu: "PERCENT USED_MB TOTAL_MB" (NVIDIA via nvidia-smi, AMD via sysfs), or "na"
gpu() {
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ',' && return
  fi
  local d
  for d in /sys/class/drm/card?/device; do
    [ -r "$d/gpu_busy_percent" ] || continue
    echo "$(cat "$d/gpu_busy_percent") $(( $(cat "$d/mem_info_vram_used" 2>/dev/null || echo 0) / 1048576 )) $(( $(cat "$d/mem_info_vram_total" 2>/dev/null || echo 0) / 1048576 ))"
    return
  done
  echo na
}
# Animated shaders need damage tracking off (Hyprland warns otherwise); static ones and off restore it.
hypr_apply() {
  local dt=2
  [ -n "$1" ] && is_animated "$1" && dt=0
  hyprctl eval "hl.config({debug={damage_tracking=$dt}, decoration={screen_shader='$1'}})" >/dev/null
}
# a running bin/cursor-bend owns the screen shader (it re-reads the state files itself within 0.2 s)
bend_running() {
  local pid; pid=$(cat "$STATE_DIR/bend.pid" 2>/dev/null)
  [ -n "$pid" ] && tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q cursor-bend
}
# strength (percent) of a layer: remembered per effect/colour, else the shader's `// strength: N` line, else 100
SDIR="$STATE_DIR/strengths"
default_strength() { local v; v=$(sed -n 's|^// strength: *||p' "$1" | head -1); echo "${v:-100}"; }
remembered_strength() { # KIND(fx|col) NAME FILE
  local f="$SDIR/$1-$2"
  if [ -s "$f" ]; then cat "$f"; else default_strength "$3"; fi
}
cur_strength() { local v; v=$(cat "$STATE_DIR/strength-$1" 2>/dev/null); echo "${v:-100}"; }
DISABLED="$STATE_DIR/disabled"
is_disabled() { [ -s "$DISABLED" ]; }
# Mixing: a second effect (effect2) or colour (color2) can be mixed into the first one. State: mix-effect / mix-color = "MODE VALUE",
# MODE stack (the second runs on the first one's result; VALUE is how much of it, percent) or blend (both run on the original picture;
# VALUE is the share of the second, percent).
# MIXWIN=1 reads and writes the mix state of the window scope in WSCOPE instead of the screen's
mixstate() { if [ -n "$MIXWIN" ]; then wpath "$1"; else echo "$STATE_DIR/$1"; fi; }
mix_second() { # effect|color PRIMARY_NAME: the name of the second layer when it is valid, else nothing
  local n f; n=$(cat "$(mixstate "${1}2")" 2>/dev/null)
  [ -n "$2" ] && [ -n "$n" ] && [ "$n" != "$2" ] || return 0
  if [ "$1" = effect ]; then f="$DIR/$n.frag"; else f=$(cfile "$n"); fi
  [ -f "$f" ] && echo "$n"
}
mix_spec() { local s; s=$(cat "$(mixstate "mix-$1")" 2>/dev/null); echo "${s:-stack 100}"; }
mix_default() { # effect|color MODE FILE_OF_SECOND: the start value for a mode
  if [ "$2" = blend ]; then echo 50; else default_strength "$3"; fi
}
MIXSIG=""; MARGS=()
mix_args() { # effect|color FLAG SECOND_NAME: sets MARGS (compose-shader flags) and MIXSIG (part of the built file name)
  local mode val pct file k=fx
  read -r mode val <<<"$(mix_spec "$1")"
  if [ "$1" = effect ]; then file="$DIR/$3.frag"; else file=$(cfile "$3"); k=col; fi
  pct=$val; [ "$mode" = blend ] && pct=$(remembered_strength "$k" "$3" "$file")
  MARGS=("$2" "$file" "$pct" "$mode" "$val"); MIXSIG="~$3.$mode$val.$pct"
}
# apply the current effect and colour layers: none, or one built shader file (bin/compose-shader)
apply() {
  window_apply >/dev/null 2>&1 || true
  frame_apply >/dev/null 2>&1 || true
  local fx col file="" out args=() fx2 col2 sig1="" sig2="" f2="" c2=""
  fx=$(current); col=$(current_color)
  [ -n "$fx" ] && [ ! -f "$DIR/$fx.frag" ] && fx=""
  [ -n "$col" ] && [ ! -f "$(cfile "$col")" ] && col=""
  if ! is_disabled && { [ -n "$fx" ] || [ -n "$col" ]; }; then
    local sf sc cf=""
    [ -n "$col" ] && cf=$(cfile "$col")
    sf=$(cur_strength effect); sc=$(cur_strength color)
    fx2=$(mix_second effect "$fx"); col2=$(mix_second color "$col")
    [ -n "$fx" ] && args+=(--fx "$DIR/$fx.frag" "$sf")
    if [ -n "$fx2" ]; then mix_args effect --fx2 "$fx2"; args+=("${MARGS[@]}"); sig1="$MIXSIG"; f2="$DIR/$fx2.frag"; fi
    [ -n "$col" ] && args+=(--col "$cf" "$sc")
    if [ -n "$col2" ]; then mix_args color --col2 "$col2"; args+=("${MARGS[@]}"); sig2="$MIXSIG"; c2=$(cfile "$col2"); fi
    out="$STATE_DIR/built/${fx:--}@${sf}${sig1}+${col:--}@${sc}${sig2}.frag"
    if [ ! -s "$out" ] || [ -n "$fx" -a "$out" -ot "$DIR/$fx.frag" ] || [ -n "$col" -a "$out" -ot "$cf" ] || [ -n "$f2" -a "$out" -ot "$f2" ] || [ -n "$c2" -a "$out" -ot "$c2" ] || [ "$out" -ot "$ROOT/bin/compose-shader" ]; then
      mkdir -p "$STATE_DIR/built"
      python3 "$ROOT/bin/compose-shader" "$out.tmp" "${args[@]}" && mv "$out.tmp" "$out" || { echo "could not build $fx + $col" >&2; exit 1; }
    fi
    find "$STATE_DIR/built" -type f -mmin +60 ! -path "$out" -delete 2>/dev/null
    find "$STATE_DIR/custom-colors" -type f -mtime +30 ! -path "$cf" ! -path "$c2" -delete 2>/dev/null
    file="$out"
  fi
  bend_running && return 0
  hypr_apply "$file"
}
# serialise state writes + apply, so a combo that sets effect and colour at once ends in the right state
lock() { mkdir -p "$STATE_DIR"; exec 9>"$STATE_DIR/lock"; flock 9; }
set_shader() {
  lock
  if [ ! -f "$DIR/$1.frag" ] && { [ -f "$CDIR/$1.frag" ] || [[ "$1" == custom-* ]]; }; then set_color "$1"; return; fi
  [ -f "$DIR/$1.frag" ] || { echo "unknown shader: $1" >&2; exit 1; }
  mkdir -p "$STATE_DIR"; echo "$1" > "$STATE"; : > "$STATE_DIR/effect2"; echo "$(remembered_strength fx "$1" "$DIR/$1.frag")" > "$STATE_DIR/strength-effect"; : > "$DISABLED"; apply
}
set_color() {
  lock
  local cf; cf=$(cfile "$1")
  [ -f "$cf" ] || { echo "unknown colour: $1" >&2; exit 1; }
  mkdir -p "$STATE_DIR"; echo "$1" > "$COLOR_STATE"; : > "$STATE_DIR/color2"; echo "$(remembered_strength col "$1" "$cf")" > "$STATE_DIR/strength-color"; : > "$DISABLED"; apply
}
# strength KIND(effect|color) VALUE: VALUE is a percent, +N, -N or reset; remembered for that effect/colour
set_strength() {
  lock
  local kind="$1" val="$2" name file k cur
  if [ "$kind" = effect ]; then name=$(current); file="$DIR/$name.frag"; k=fx; else name=$(current_color); file=$(cfile "$name"); k=col; fi
  [ -n "$name" ] && [ -f "$file" ] || { echo "no $kind set" >&2; exit 1; }
  cur=$(cur_strength "$kind")
  case "$val" in
    reset) val=$(default_strength "$file") ;;
    +*|-*) val=$(( cur + val )) ;;
    ''|*[!0-9]*) echo "usage: omashaders strength effect|color PERCENT|+N|-N|reset" >&2; exit 1 ;;
  esac
  [ "$val" -lt 0 ] && val=0; [ "$val" -gt 100 ] && val=100
  mkdir -p "$SDIR"; echo "$val" > "$STATE_DIR/strength-$kind"; echo "$val" > "$SDIR/$k-$name"
  apply
}
set_overlay_strength() { # wall|mouse [PERCENT|+N|-N|reset]: opacity of the wallpaper / cursor effect (read by the bar widget and cursor-bend)
  local f="$STATE_DIR/strength-$1" val="$2" cur
  cur=$(cat "$f" 2>/dev/null); case "$cur" in ''|*[!0-9]*) cur=100 ;; esac
  case "$val" in
    '') echo "$cur"; return ;;
    reset) val=100 ;;
    +*|-*) val=$(( cur + val )) ;;
    *[!0-9]*) echo "usage: omashaders strength wall|mouse PERCENT|+N|-N|reset" >&2; exit 1 ;;
  esac
  [ "$val" -lt 0 ] && val=0; [ "$val" -gt 100 ] && val=100
  mkdir -p "$STATE_DIR"; echo "$val" > "$f"
}
power() { # [status|on|off|toggle] ; "on" = shaders enabled
  lock
  local want="${1:-status}" now=on
  is_disabled && now=off
  [ "$want" = toggle ] && { [ "$now" = on ] && want=off || want=on; }
  case "$want" in
    on) : > "$DISABLED"; apply ;;
    off) mkdir -p "$STATE_DIR"; echo 1 > "$DISABLED"; apply ;;
    *) echo "$now"; return ;;
  esac
  window_apply
  if [ "$2" = --notify ] && command -v notify-send >/dev/null 2>&1; then
    local fx col msg="paused"
    fx=$(current); col=$(current_color)
    [ "$want" = on ] && msg="on: ${fx:-no effect}${col:+ + $col}"
    notify-send -a OmaShaders -t 1500 -h string:x-canonical-private-synchronous:omashaders "OmaShaders" "$msg" >/dev/null 2>&1
  fi
  echo "$want"
}
effect_off() { lock; : > "$STATE"; : > "$STATE_DIR/effect2"; apply; }
color_off() { lock; : > "$COLOR_STATE"; : > "$STATE_DIR/color2"; apply; }
turn_off() { lock; : > "$STATE"; : > "$COLOR_STATE"; : > "$STATE_DIR/effect2"; : > "$STATE_DIR/color2"; apply; }
# mix effect|color [status|set NAME|off|mode stack|blend|toggle|amount N|+N|-N|reset]: a second effect (colour) mixed into the first
mix_cmd() { lock; mix_run "$@"; }
mix_run() {
  local kind="$1" cmd="${2:-status}" arg="$3" prim second file k=fx mode val
  if [ -n "$MIXWIN" ]; then prim=$(wcur "$kind"); [ "$kind" = effect ] || k=col
  elif [ "$kind" = effect ]; then prim=$(current); else prim=$(current_color); k=col; fi
  second=$(cat "$(mixstate "${kind}2")" 2>/dev/null)
  read -r mode val <<<"$(mix_spec "$kind")"
  mkdir -p "$STATE_DIR"
  mixfile() { if [ "$kind" = effect ]; then echo "$DIR/$1.frag"; else cfile "$1"; fi; }
  case "$cmd" in
    status) if [ -n "$(mix_second "$kind" "$prim")" ]; then echo "$second $mode $val"; else echo off; fi; return ;;
    set)
      [ -n "$prim" ] || { echo "set a first $kind before mixing a second one" >&2; return 1; }
      [ "$arg" != "$prim" ] || { echo "the second $kind must differ from the first" >&2; return 1; }
      file=$(mixfile "$arg"); [ -f "$file" ] || { echo "unknown $kind: $arg" >&2; return 1; }
      echo "$arg" > "$(mixstate "${kind}2")"; echo "$mode $(mix_default "$kind" "$mode" "$file")" > "$(mixstate "mix-$kind")"; : > "$DISABLED" ;;
    off) : > "$(mixstate "${kind}2")" ;;
    mode)
      [ -n "$second" ] || { echo "no second $kind to mix" >&2; return 1; }
      case "$arg" in toggle) [ "$mode" = stack ] && arg=blend || arg=stack ;; stack|blend) ;; *) echo "usage: omashaders mix $kind mode stack|blend|toggle" >&2; return 1 ;; esac
      echo "$arg $(mix_default "$kind" "$arg" "$(mixfile "$second")")" > "$(mixstate "mix-$kind")" ;;
    amount)
      [ -n "$second" ] || { echo "no second $kind to mix" >&2; return 1; }
      [ -n "$arg" ] || { echo "$val"; return; }
      case "$arg" in
        reset) val=$(mix_default "$kind" "$mode" "$(mixfile "$second")") ;;
        +*|-*) val=$(( val + arg )) ;;
        ''|*[!0-9]*) echo "usage: omashaders mix $kind amount PERCENT|+N|-N|reset" >&2; return 1 ;;
        *) val=$arg ;;
      esac
      [ "$val" -lt 0 ] && val=0; [ "$val" -gt 100 ] && val=100
      echo "$mode $val" > "$(mixstate "mix-$kind")" ;;
    *) echo "usage: omashaders mix effect|color [status|set NAME|off|mode stack|blend|toggle|amount PERCENT|+N|-N|reset]" >&2; return 1 ;;
  esac
  if [ -n "$MIXWIN" ]; then window_apply; else apply; fi
}
# ---- window shaders: the same effect and colour lists, drawn on windows only (needs the HyprWindowShade Hyprland plugin) ----
# State: window-effect, window-color, window-target (one line per app class, or "*" for all windows), window-applied (classes we set).
WSH_LUA='hl.plugin.HyprWindowShade'
WDIR="$STATE_DIR/built-win"
# Settings come from the all-windows scope ("*", files window-KEY) or from one app's own override
# (window-app/CLASS/KEY). WSCOPE picks the scope; an app with an override ignores the all-windows setting.
WAPP="$STATE_DIR/window-app"
WSCOPE='*'
wpath() { if [ "$WSCOPE" = '*' ]; then echo "$STATE_DIR/window-$1"; else echo "$WAPP/$WSCOPE/$1"; fi; }
wcur() { cat "$(wpath "$1")" 2>/dev/null; }
wcur_strength() { local v; v=$(cat "$(wpath "strength-$1")" 2>/dev/null); echo "${v:-100}"; }
# copy the all-windows settings into a new override so the first change only alters one part
app_seed() {
  local d="$WAPP/$1" k
  [ -d "$d" ] && return 0
  mkdir -p "$d"
  for k in effect color strength-effect strength-color effect2 color2 mix-effect mix-color; do cp "$STATE_DIR/window-$k" "$d/$k" 2>/dev/null || : > "$d/$k"; done
}
# one line per app override for the menu: CLASS<TAB>effect<TAB>color<TAB>effect%<TAB>color%
apps_summary() {
  local d c out="" f="$STATE_DIR/window-apps" sc="$WSCOPE"
  for d in "$WAPP"/*/; do
    [ -d "$d" ] || continue
    c=$(basename "$d"); WSCOPE=$c
    out+=$(printf '%s\t%s\t%s\t%s\t%s' "$c" "$(wcur effect)" "$(wcur color)" "$(wcur_strength effect)" "$(wcur_strength color)")$'\n'
  done
  WSCOPE=$sc
  mix_summary
  [ -f "$f" ] && [ "$(cat "$f")" = "${out%$'\n'}" ] && return 0
  mkdir -p "$STATE_DIR"; printf '%s' "$out" > "$f.tmp" && mv "$f.tmp" "$f"
}
# one line per scope for the menu's mixing rows: SCOPE<TAB>effect2<TAB>color2<TAB>effect mode<TAB>effect amount<TAB>color mode<TAB>color amount
mix_summary() {
  local out="" f="$STATE_DIR/window-mix" sc="$WSCOPE" c fm fv cm cv d
  for d in "$STATE_DIR/" "$WAPP"/*/; do
    [ -d "$d" ] || continue
    if [ "$d" = "$STATE_DIR/" ]; then c='*'; else c=$(basename "$d"); fi
    WSCOPE=$c
    read -r fm fv <<<"$(MIXWIN=1 mix_spec effect)"; read -r cm cv <<<"$(MIXWIN=1 mix_spec color)"
    out+=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' "$c" "$(wcur effect2)" "$(wcur color2)" "$fm" "$fv" "$cm" "$cv")$'\n'
  done
  WSCOPE=$sc
  [ -f "$f" ] && [ "$(cat "$f")" = "${out%$'\n'}" ] && return 0
  mkdir -p "$STATE_DIR"; printf '%s' "$out" > "$f.tmp" && mv "$f.tmp" "$f"
}
window_plugin_loaded() { hyprctl plugin list 2>/dev/null | grep -q 'HyprWindowShade'; }
window_plugin_file() {
  local f
  for f in "${OMASHADERS_WINDOW_PLUGIN:-}" "${XDG_DATA_HOME:-$HOME/.local/share}/hyprland/plugins/HyprWindowShade.so" "/var/cache/hyprpm/$USER/HyprWindowShade/HyprWindowShade.so"; do
    [ -n "$f" ] && [ -f "$f" ] && { echo "$f"; return 0; }
  done
  return 1
}
# load the plugin into the running session; a truncated .so can crash Hyprland, so a stored .md5 must match
window_load() {
  window_plugin_loaded && return 0
  local f; f=$(window_plugin_file) || { echo "HyprWindowShade is not installed (see README: Window shaders)" >&2; return 1; }
  if [ -f "$f.md5" ] && [ "$(md5sum < "$f" | cut -d' ' -f1)" != "$(cut -d' ' -f1 < "$f.md5")" ]; then echo "plugin file is damaged (md5 differs): $f" >&2; return 1; fi
  hyprctl plugin load "$f" >/dev/null 2>&1; window_plugin_loaded
}
safe_class() { [[ "$1" =~ ^[A-Za-z0-9._:+@\ -]+$ ]]; }
open_classes() { hyprctl clients -j 2>/dev/null | python3 -c 'import json,sys
seen=[]
for c in json.load(sys.stdin):
    k=c.get("class") or ""
    if k and k not in seen: seen.append(k)
print("\n".join(seen))'; }
# shell surfaces (bars, panels, overlays like the Companion pill) are layers, not windows; the plugin shades them by namespace
open_layers() { hyprctl layers -j 2>/dev/null | python3 -c 'import json,sys
skip={"omarchy-background","wallpaper-fx","omashaders-mouse","omashaders-bend-marker"}
seen=[]
for m in json.load(sys.stdin).values():
    for lv in m.get("levels",{}).values():
        for l in lv:
            k=l.get("namespace") or ""
            if k and k not in skip and k not in seen: seen.append(k)
print("\n".join("layer:"+k for k in seen))'; }
# "All windows" also covers shell panels and flyouts: every open layer plus the known ones (so a flyout is shaded from its first
# frame) plus layers shaded before; not the bar, wallpaper, mouse overlay or invisible click-catchers
ALL_LAYERS_KNOWN="aktlabs-companion-pill agent-mascots aktlabs-companion omarchy-keyboard-panel omarchy-menu omarchy-image-selector omarchy-emojis omarchy-clipboard omarchy-notifications omarchy-osd omarchy-reminders omarchy-polkit omarchy-network-qr scratchpad-frame"
all_layers() {
  { open_layers | sed 's/^layer://'; printf '%s\n' $ALL_LAYERS_KNOWN; grep '^layer:' "$STATE_DIR/window-applied" 2>/dev/null | sed 's/^layer://'; } |
    grep . | grep -vE '^(omarchy-bar|omarchy-background|wallpaper-fx|omashaders-mouse|omashaders-bend-marker|omarchy-lock-preview|.*-dismiss|.*-ghost)$' | sort -u | sed 's/^/layer:/'
}
# the built window shader for the current window effect + colour (empty when none)
window_file() {
  local fx col sf sc cf="" out args=()
  fx=$(wcur effect); col=$(wcur color)
  [ -n "$fx" ] && [ ! -f "$DIR/$fx.frag" ] && fx=""
  [ -n "$col" ] && [ ! -f "$(cfile "$col")" ] && col=""
  [ -z "$fx$col" ] && return 0
  [ -n "$col" ] && cf=$(cfile "$col")
  sf=$(wcur_strength effect); sc=$(wcur_strength color)
  local MIXWIN=1 fx2 col2 sig1="" sig2="" f2="" c2=""
  fx2=$(mix_second effect "$fx"); col2=$(mix_second color "$col")
  [ -n "$fx" ] && args+=(--fx "$DIR/$fx.frag" "$sf")
  if [ -n "$fx2" ]; then mix_args effect --fx2 "$fx2"; args+=("${MARGS[@]}"); sig1="$MIXSIG"; f2="$DIR/$fx2.frag"; fi
  [ -n "$col" ] && args+=(--col "$cf" "$sc")
  if [ -n "$col2" ]; then mix_args color --col2 "$col2"; args+=("${MARGS[@]}"); sig2="$MIXSIG"; c2=$(cfile "$col2"); fi
  out="$WDIR/${fx:--}@${sf}${sig1}+${col:--}@${sc}${sig2}.frag"
  if [ ! -s "$out" ] || [ "$out" -ot "$ROOT/bin/compose-shader" ] || { [ -n "$fx" ] && [ "$out" -ot "$DIR/$fx.frag" ]; } || { [ -n "$col" ] && [ "$out" -ot "$cf" ]; } || { [ -n "$f2" ] && [ "$out" -ot "$f2" ]; } || { [ -n "$c2" ] && [ "$out" -ot "$c2" ]; }; then
    mkdir -p "$WDIR"
    python3 "$ROOT/bin/compose-shader" "$out.tmp" --window "${args[@]}" && mv "$out.tmp" "$out" || { echo "could not build window shader $fx + $col" >&2; return 1; }
  fi
  echo "$out"
}
wsh_class() { # CLASS PATH|clear; "layer:NAMESPACE" targets go to the plugin's layer shaders
  case "$1" in
    layer:*) hyprctl eval "$WSH_LUA.layershader(\"${1#layer:}\",\"$2\")" >/dev/null 2>&1 ;;
    *) hyprctl eval "$WSH_LUA.classshader(\"$1\",\"$2\")" >/dev/null 2>&1 ;;
  esac
}
# make the plugin's per-class shaders match the state: every target class gets the all-windows shader unless it has its
# own override; classes we set before and no longer want are cleared
window_apply() {
  local applied="$STATE_DIR/window-applied" c f d gfile="" tg anyset=0 want=() old=() keep=() sig fresh=0
  local sigf="$STATE_DIR/window-sig"
  local -A map=()
  [ -n "$(WSCOPE='*' wcur effect)$(WSCOPE='*' wcur color)" ] && anyset=1
  for d in "$WAPP"/*/; do [ -d "$d" ] && anyset=1; done
  [ "$anyset" = 1 ] || [ -s "$applied" ] || return 0
  if ! window_plugin_loaded; then
    [ "$anyset" = 1 ] && ! is_disabled || return 0
    window_load || return 1
    fresh=1
  fi
  if ! is_disabled; then
    gfile=$(WSCOPE='*' window_file) || return 1
    if [ -n "$gfile" ]; then
      tg=$(cat "$STATE_DIR/window-target" 2>/dev/null)
      if grep -qx '\*' <<<"$tg"; then while read -r c; do [ -n "$c" ] && map["$c"]=$gfile; done < <(open_classes; all_layers; grep -vx '\*' <<<"$tg")
      else while read -r c; do [ -n "$c" ] && map["$c"]=$gfile; done <<<"$tg"; fi
    fi
    for d in "$WAPP"/*/; do
      [ -d "$d" ] || continue
      c=$(basename "$d")
      f=$(WSCOPE=$c window_file) || continue
      if [ -n "$f" ]; then map["$c"]=$f; else unset 'map["$c"]'; fi
    done
  fi
  while read -r c; do [ -n "$c" ] && want+=("$c"); done < <(printf '%s\n' "${!map[@]}" | sort)
  sig="$HYPRLAND_INSTANCE_SIGNATURE|$(hyprctl plugin list 2>/dev/null | sed -n 's/.*Handle: //p')"
  for c in "${want[@]}"; do sig+="|$c=${map[$c]}"; done
  [ "$fresh" = 0 ] && [ "$(cat "$sigf" 2>/dev/null)" = "$sig" ] && return 0
  [ -s "$applied" ] && mapfile -t old < "$applied"
  for c in "${old[@]}"; do
    [[ -v map["$c"] ]] || { safe_class "$c" && wsh_class "$c" clear; }
  done
  : > "$applied.tmp"
  for c in "${want[@]}"; do
    safe_class "$c" || continue
    wsh_class "$c" "${map[$c]}"; echo "$c" >> "$applied.tmp"
  done
  mv "$applied.tmp" "$applied"; echo "$sig" > "$sigf"
  for c in "${want[@]}"; do keep+=("${map[$c]}"); done
  while read -r f; do [[ " ${keep[*]} " == *" $f "* ]] || rm -f -- "$f"; done < <(find "$WDIR" -type f -mmin +60 2>/dev/null)
}
window_target() { # all | none | add CLASS | remove CLASS | toggle CLASS | here
  local f="$STATE_DIR/window-target" mode="$1" cls="$2" cur
  mkdir -p "$STATE_DIR"; touch "$f"
  case "$mode" in
    all) echo '*' > "$f" ;;
    none) : > "$f" ;;
    here) cls=$(hyprctl activewindow -j 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("class",""))'); [ -n "$cls" ] || { echo "no active window" >&2; return 1; }; mode=toggle ;;
  esac
  case "$mode" in
    add|remove|toggle|here)
      safe_class "$cls" || { echo "bad class name: $cls" >&2; return 1; }
      cur=$(grep -vx '\*' "$f" 2>/dev/null)
      if grep -qxF -- "$cls" "$f"; then [ "$mode" = add ] || cur=$(grep -vxF -- "$cls" <<<"$cur"); else [ "$mode" = remove ] || cur=$(printf '%s\n%s' "$cur" "$cls"); fi
      grep -qx '\*' "$f" && cur=$(printf '*\n%s' "$cur")
      printf '%s\n' "$cur" | grep . > "$f" || : > "$f" ;;
  esac
}
window_set() { # effect|color NAME|off
  local kind="$1" name="$2" dir="$DIR" k=fx file
  [ "$kind" = color ] && { dir="$CDIR"; k=col; }
  mkdir -p "$STATE_DIR"
  : > "$(wpath "${kind}2")"
  if [ "$name" = off ] || [ -z "$name" ]; then : > "$(wpath "$kind")"
  else
    if [ "$kind" = color ]; then file=$(cfile "$name"); else file="$dir/$name.frag"; fi
    [ -f "$file" ] || { echo "unknown $kind: $name" >&2; return 1; }
    echo "$name" > "$(wpath "$kind")"
    echo "$(remembered_strength "$k" "$name" "$file")" > "$(wpath "strength-$kind")"
    [ "$WSCOPE" != '*' ] || [ -s "$STATE_DIR/window-target" ] || echo '*' > "$STATE_DIR/window-target"
  fi
}
window_strength() { # effect|color [PERCENT|+N|-N|reset]
  local kind="$1" val="$2" cur name file
  cur=$(wcur_strength "$kind")
  [ -z "$val" ] && { echo "$cur"; return; }
  name=$(wcur "$kind")
  if [ "$kind" = effect ]; then file="$DIR/$name.frag"; else file=$(cfile "$name"); fi
  case "$val" in
    reset) val=$(default_strength "$file") ;;
    +*|-*) val=$(( cur + val )) ;;
    ''|*[!0-9]*) echo "usage: omashaders window strength effect|color PERCENT|+N|-N|reset" >&2; return 1 ;;
  esac
  [ "$val" -lt 0 ] && val=0; [ "$val" -gt 100 ] && val=100
  echo "$val" > "$(wpath "strength-$kind")"
}
# ---- window frames: shadow / glow / border presets through Hyprland's own options (bin/frame-apply keeps the original look) ----
frame_apply() { # make Hyprland match the chosen frame (none while paused); cheap when nothing is set
  local name=""
  is_disabled || name=$(cat "$STATE_DIR/window-frame" 2>/dev/null)
  [ -n "$name" ] || [ -f "$STATE_DIR/frame-base.json" ] || return 0
  python3 "$ROOT/bin/frame-apply" "$STATE_DIR" "$FRDIR" "$name"
}
frame_names() { for f in "$FRDIR"/*.frame; do [ -e "$f" ] && basename "$f" .frame; done; }
frame_cmd() {
  case "${1:-status}" in
    status) cat "$STATE_DIR/window-frame" 2>/dev/null | grep . || echo off ;;
    list) frame_names ;;
    off) mkdir -p "$STATE_DIR"; : > "$STATE_DIR/window-frame"; frame_apply ;;
    set) [[ "$2" =~ ^[A-Za-z0-9._-]+$ ]] && [ -f "$FRDIR/$2.frame" ] || { echo "unknown frame: $2" >&2; return 1; }
         mkdir -p "$STATE_DIR"; echo "$2" > "$STATE_DIR/window-frame"; frame_apply ;;
    reload|sync) [ -n "$(cat "$STATE_DIR/window-frame" 2>/dev/null)" ] || return 0
         [ "$1" = reload ] && rm -f "$STATE_DIR/frame-base.json"; frame_apply ;;
    *) echo "usage: omashaders window frame [status|list|set NAME|off|reload|sync]" >&2; return 1 ;;
  esac
}
window_cmd() {
  lock
  WSCOPE='*'
  if [ "${1:-}" = -a ]; then # window -a CLASS ...: act on one app's own settings
    WSCOPE=$2; shift 2
    safe_class "$WSCOPE" && [[ "$WSCOPE" != .* ]] || { echo "bad class name: $WSCOPE" >&2; return 1; }
    case "${1:-status}" in
      inherit) rm -rf -- "${WAPP:?}/$WSCOPE"; window_apply; apps_summary; return ;;
      status) if [ -d "$WAPP/$WSCOPE" ]; then printf 'own effect=%s color=%s strength=%s/%s\n' "$(wcur effect | grep . || echo off)" "$(wcur color | grep . || echo off)" "$(wcur_strength effect)" "$(wcur_strength color)"; else echo inherits; fi; return ;;
      off) app_seed "$WSCOPE"; : > "$(wpath effect)"; : > "$(wpath color)"; window_apply; apps_summary; return ;;
      effect|color|strength|mix) app_seed "$WSCOPE" ;;
    esac
  fi
  window_cmd_run "$@"; local rc=$?
  apps_summary
  return $rc
}
window_cmd_run() {
  case "${1:-status}" in
    status) printf 'plugin=%s effect=%s color=%s strength=%s/%s target=%s\n' "$(window_plugin_loaded && echo loaded || { window_plugin_file >/dev/null && echo installed || echo missing; })" \
      "$(wcur effect | grep . || echo off)" "$(wcur color | grep . || echo off)" "$(wcur_strength effect)" "$(wcur_strength color)" "$(cat "$STATE_DIR/window-target" 2>/dev/null | paste -sd, | grep . || echo none)" ;;
    effect|color) case "$2" in
        set) window_set "$1" "$3" && window_apply ;;
        off) window_set "$1" off && window_apply ;;
        status) wcur "$1" | grep . || echo off ;;
        list) if [ "$1" = effect ]; then names -a; else color_names; fi ;;
        *) echo "usage: omashaders window [-a CLASS] $1 [status|list|set NAME|off]" >&2; return 1 ;;
      esac ;;
    strength) window_strength "$2" "$3" && window_apply ;;
    mix) case "$2" in effect|color) MIXWIN=1 mix_run "$2" "$3" "$4" ;; *) echo "usage: omashaders window [-a CLASS] mix effect|color [status|set NAME|off|mode stack|blend|toggle|amount PERCENT|+N|-N|reset]" >&2; return 1 ;; esac ;;
    target) case "$2" in
        '') cat "$STATE_DIR/window-target" 2>/dev/null ;;
        *) window_target "$2" "$3" && window_apply ;;
      esac ;;
    classes) open_classes; all_layers ;;
    apps) cat "$STATE_DIR/window-apps" 2>/dev/null ;;
    apply|sync) window_apply ;;
    load) window_load ;;
    frame) frame_cmd "$2" "$3" ;;
    off) : > "$STATE_DIR/window-effect"; : > "$STATE_DIR/window-color"; rm -rf -- "${WAPP:?}"; for k in effect2 color2 mix-effect mix-color; do : > "$STATE_DIR/window-$k"; done; window_apply; frame_cmd off ;;
    *) echo "usage: omashaders window [-a CLASS inherit|off|status|effect|color|strength ...] [status|effect|color|strength|target|classes|apps|apply|load|off|frame]" >&2; return 1 ;;
  esac
}
step() { # step DIRECTION(1|-1) [-a]
  local list=() n cur i idx=-1
  while read -r n; do [ -n "$n" ] && list+=("$n"); done < <(names "$2")
  cur=$(current)
  [ ${#list[@]} -gt 0 ] || { effect_off; return; }
  for i in "${!list[@]}"; do [ "${list[$i]}" = "$cur" ] && idx=$i; done
  # positions 0..N-1 are shaders, N is "off"; an unknown/off current sits at N
  local total=$(( ${#list[@]} + 1 )) pos=$(( idx < 0 ? ${#list[@]} : idx ))
  pos=$(( (pos + $1 + total) % total ))
  if [ "$pos" -eq ${#list[@]} ]; then effect_off; else set_shader "${list[$pos]}"; fi
}
case "${1:-}" in
  list) names "$2" ;;
  listall) # NAME<TAB>static|animated<TAB>Category<TAB>description
    declare -A PN # measured cost (bin/perf-log report) appended to the description of effects that are not light
    while IFS=$'\t' read -r pk pn pr pc _; do [ "$pr" = light ] || PN["$pk:$pn"]=" [measured: $pr, +$pc% GPU]"; done < "$STATE_DIR/perf-summary.tsv" 2>/dev/null
    for f in "$DIR"/*.frag; do
      n=$(basename "$f" .frag); kind=static; is_animated "$f" && kind=animated
      cat=$(sed -n 's|^// category: *||p' "$f" | head -1); desc=$(sed -n 's|^// desc: *||p' "$f" | head -1)
      printf '%s\t%s\t%s\t%s\tscreen\t%s\n' "$n" "$kind" "${cat:-Other}" "$desc${PN[screen:$n]}" "$(default_strength "$f")"
    done
    for f in "$CDIR"/*.frag; do
      [ -e "$f" ] || continue
      n=$(basename "$f" .frag)
      cat=$(sed -n 's|^// category: *||p' "$f" | head -1); desc=$(sed -n 's|^// desc: *||p' "$f" | head -1)
      printf '%s\tstatic\t%s\t%s\tcolor\t%s\n' "$n" "${cat:-Other}" "$desc${PN[color:$n]}" "$(default_strength "$f")"
    done
    for f in "$FRDIR"/*.frame; do # window frames (shadow, glow, border)
      [ -e "$f" ] || continue
      n=$(basename "$f" .frame); kind=static; grep -q '^spin=' "$f" && kind=motion
      cat=$(sed -n 's|^# category: *||p' "$f" | head -1); desc=$(sed -n 's|^# desc: *||p' "$f" | head -1)
      printf '%s\t%s\t%s\t%s\tframe\n' "$n" "$kind" "${cat:-Other}" "$desc"
    done
    for f in "$MDIR"/*.frag; do
      [ -e "$f" ] || continue
      n=$(basename "$f" .frag); kind=static; [ "$(sed -n 's|^// motion: *||p' "$f" | head -1)" = yes ] && kind=motion
      cat=$(sed -n 's|^// category: *||p' "$f" | head -1); desc=$(sed -n 's|^// desc: *||p' "$f" | head -1)
      printf '%s\t%s\t%s\t%s\tmouse\n' "$n" "$kind" "${cat:-Other}" "$desc${PN[cursor:$n]}"
    done
    for f in "$ROOT"/wallpaper-effects/*.frag; do # wallpaper effects; the menu lists ones it does not know yet (// label: and // hint: header lines)
      [ -e "$f" ] || continue
      n=$(basename "$f" .frag)
      lab=$(sed -n 's|^// label: *||p' "$f" | head -1); hint=$(sed -n 's|^// hint: *||p' "$f" | head -1)
      printf '%s\tstatic\t%s\t%s\twall\n' "$n" "${lab:-$n}" "$hint${PN[wall:$n]}"
    done
    for f in "$BDIR"/*.frag; do # cursor-bend shaders: they bend the real screen (bin/cursor-bend)
      [ -e "$f" ] || continue
      n=$(basename "$f" .frag); kind=static; [ -n "$(sed -n 's|^// tail: *||p' "$f" | head -1)" ] && kind=motion
      cat=$(sed -n 's|^// category: *||p' "$f" | head -1); desc=$(sed -n 's|^// desc: *||p' "$f" | head -1)
      printf '%s\t%s\t%s\t%s\tmouse\tbend\n' "$n" "$kind" "${cat:-Bend}" "$desc${PN[cursor:$n]}"
    done ;;
  effect)
    case "${2:-status}" in
      status) current | grep . || echo off ;;
      list) names -a ;;
      off) effect_off ;;
      set) set_shader "$3" ;;
      *) echo "usage: omashaders effect [status|list|set NAME|off]" >&2; exit 1 ;;
    esac ;;
  color)
    case "${2:-status}" in
      status) current_color | grep . || echo off ;;
      list) color_names ;;
      off) color_off ;;
      set) set_color "$3" ;;
      *) echo "usage: omashaders color [status|list|set NAME|off]" >&2; exit 1 ;;
    esac ;;
  mouse) # an overlay drawn by the bar icon around the cursor; independent of the screen shader
    MSTATE="$STATE_DIR/mouse"
    case "${2:-status}" in
      status) cat "$MSTATE" 2>/dev/null | grep . || echo off ;;
      list) for f in "$MDIR"/*.frag "$BDIR"/*.frag; do [ -e "$f" ] && basename "$f" .frag; done ;;
      off) mkdir -p "$STATE_DIR"; : > "$MSTATE" ;;
      set) [ -f "$MDIR/$3.frag.qsb" ] || [ -f "$BDIR/$3.frag" ] || { echo "unknown mouse effect: $3" >&2; exit 1; }
           mkdir -p "$STATE_DIR"; echo "$3" > "$MSTATE"
           if is_disabled; then lock; : > "$DISABLED"; apply; fi ;;
      *) echo "usage: omashaders mouse [status|list|set NAME|off]" >&2; exit 1 ;;
    esac ;;
  animated)
    case "${2:-}" in
      on) val=1 ;;
      off) val=0 ;;
      toggle) if [ "$(animated_flag)" = 1 ]; then val=0; else val=1; fi ;;
      *) animated_flag | grep . || echo 0; exit 0 ;;
    esac
    mkdir -p "$STATE_DIR"; echo "$val" > "$STATE_DIR/animated"
    cur=$(current)
    if [ "$val" = 0 ] && [ -n "$cur" ] && [ -f "$DIR/$cur.frag" ] && is_animated "$DIR/$cur.frag"; then effect_off; fi ;;
  gpu) gpu ;;
  perf) shift; exec python3 "$ROOT/bin/perf-log" "$@" ;;
  strength)
    case "${2:-}" in
      '') echo "effect $(cur_strength effect) color $(cur_strength color)" ;;
      effect|color) if [ -z "$3" ]; then cur_strength "$2"; else set_strength "$2" "$3"; fi ;;
      wall|mouse) set_overlay_strength "$2" "$3" ;;
      *) echo "usage: omashaders strength [effect|color|wall|mouse [PERCENT|+N|-N|reset]]" >&2; exit 1 ;;
    esac ;;
  wallopt) # wallpaper effect options: react 0-200 (mouse reaction, 100 = as designed) | range 0-100 and target RRGGBB (Colour reactor)
    f=""; max=100; min=0; def=100
    case "$2" in
      react) f="$STATE_DIR/react-wall"; max=200 ;;
      speed) f="$STATE_DIR/wall-speed"; max=300 ;;
      zoom) f="$STATE_DIR/wall-zoom"; max=300; min=25 ;;
      range) f="$STATE_DIR/wall-range"; def=50 ;;
      target) f="$STATE_DIR/wall-target" ;;
      *) echo "usage: omashaders wallopt react|speed|zoom|range [PERCENT|+N|-N|reset] | target [RRGGBB]" >&2; exit 1 ;;
    esac
    if [ "$2" = target ]; then
      if [ -z "$3" ]; then cat "$f" 2>/dev/null | grep . || echo e8a33d; exit 0; fi
      v=$(echo "${3#\#}" | tr 'A-F' 'a-f'); case "$v" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;; *) echo "target must be RRGGBB" >&2; exit 1 ;; esac
      mkdir -p "$STATE_DIR"; echo "$v" > "$f"; exit 0
    fi
    cur=$(cat "$f" 2>/dev/null); case "$cur" in ''|*[!0-9]*) cur=$def ;; esac
    val="$3"
    case "$val" in
      '') echo "$cur"; exit 0 ;;
      reset) val=$def ;;
      +*|-*) val=$(( cur + val )) ;;
      *[!0-9]*) echo "usage: omashaders wallopt $2 PERCENT|+N|-N|reset" >&2; exit 1 ;;
    esac
    [ "$val" -lt "$min" ] && val=$min; [ "$val" -gt "$max" ] && val=$max
    mkdir -p "$STATE_DIR"; echo "$val" > "$f" ;;
  mix) case "$2" in effect|color) mix_cmd "$2" "$3" "$4" ;; *) echo "usage: omashaders mix effect|color [status|set NAME|off|mode stack|blend|toggle|amount N]" >&2; exit 1 ;; esac ;;
  window) shift; window_cmd "$@" ;;
  power) power "$2" "$3" ;;
  status) current | grep . || echo off ;;
  off) turn_off ;;
  on|set) set_shader "$2" ;;
  toggle) if [ -n "$(current)$(current_color)" ]; then turn_off; else set_shader "${2:-vignette}"; fi ;;
  next) step 1 "$2" ;;
  prev) step -1 "$2" ;;
  reapply) [ -n "$(current)$(current_color)" ] && apply ;;
  reapply-force) lock; apply ;;
  *) sed -n 2,5p "$0" | sed 's/^# \?//' >&2; exit 1 ;;
esac
