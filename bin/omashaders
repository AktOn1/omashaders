#!/usr/bin/env bash
# omashaders: switch Hyprland full-screen GLSL shaders (all monitors, GPU-side)
# usage: omashaders list [-a] | listall (name, static|animated, category, description; tab separated) | status | set NAME | off | toggle [NAME] | next [-a] | prev [-a] | reapply | animated [on|off|toggle] | gpu
# The cycle is: each shader, then off. Shaders that declare `uniform float time` (animated)
# are skipped unless -a is given: they force Hyprland to redraw the whole screen every frame.
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/shaders"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/io.github.akton1.omashaders"
STATE="$STATE_DIR/current"
names() {
  for f in "$DIR"/*.frag; do
    [ -e "$f" ] || continue
    [ "$1" = "-a" ] || ! grep -q 'uniform[[:space:]]\+float[[:space:]]\+time' "$f" || continue
    basename "$f" .frag
  done
}
current() { cat "$STATE" 2>/dev/null; }
is_animated() { grep -q 'uniform[[:space:]]\+float[[:space:]]\+time' "$1"; }
# "animated" is a persisted on/off switch for the picker and the cycle; prints 1 or 0 (empty = never set)
animated_flag() { cat "$STATE_DIR/animated" 2>/dev/null; }
# gpu: "PERCENT USED_MB TOTAL_MB" (NVIDIA via nvidia-smi, AMD via sysfs), or "na"
gpu() {
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ',' && return
  fi
  local d
  for d in /sys/class/drm/card?/device; do
    [ -r "$d/gpu_busy_percent" ] || continue
    echo "$(cat "$d/gpu_busy_percent") $(( $(cat "$d/mem_info_vram_used" 2>/dev/null || echo 0) / 1048576 )) $(( $(cat "$d/mem_info_vram_total" 2>/dev/null || echo 0) / 1048576 ))"
    return
  done
  echo na
}
# Animated shaders need damage tracking off (Hyprland warns otherwise); static ones and off restore it.
apply() {
  local dt=2
  [ -n "$1" ] && is_animated "$1" && dt=0
  hyprctl eval "hl.config({debug={damage_tracking=$dt}, decoration={screen_shader='$1'}})" >/dev/null
}
set_shader() {
  [ -f "$DIR/$1.frag" ] || { echo "unknown shader: $1" >&2; exit 1; }
  apply "$DIR/$1.frag"; mkdir -p "$STATE_DIR"; echo "$1" > "$STATE"
}
turn_off() { apply ""; rm -f "$STATE"; }
step() { # step DIRECTION(1|-1) [-a]
  local list=() n cur i idx=-1
  while read -r n; do [ -n "$n" ] && list+=("$n"); done < <(names "$2")
  cur=$(current)
  [ ${#list[@]} -gt 0 ] || { turn_off; return; }
  for i in "${!list[@]}"; do [ "${list[$i]}" = "$cur" ] && idx=$i; done
  # positions 0..N-1 are shaders, N is "off"; an unknown/off current sits at N
  local total=$(( ${#list[@]} + 1 )) pos=$(( idx < 0 ? ${#list[@]} : idx ))
  pos=$(( (pos + $1 + total) % total ))
  if [ "$pos" -eq ${#list[@]} ]; then turn_off; else set_shader "${list[$pos]}"; fi
}
case "${1:-}" in
  list) names "$2" ;;
  listall) # NAME<TAB>static|animated<TAB>Category<TAB>description
    for f in "$DIR"/*.frag; do
      n=$(basename "$f" .frag); kind=static; is_animated "$f" && kind=animated
      cat=$(sed -n 's|^// category: *||p' "$f" | head -1); desc=$(sed -n 's|^// desc: *||p' "$f" | head -1)
      printf '%s\t%s\t%s\t%s\n' "$n" "$kind" "${cat:-Other}" "$desc"
    done ;;
  animated)
    case "${2:-}" in
      on) val=1 ;;
      off) val=0 ;;
      toggle) if [ "$(animated_flag)" = 1 ]; then val=0; else val=1; fi ;;
      *) animated_flag | grep . || echo 0; exit 0 ;;
    esac
    mkdir -p "$STATE_DIR"; echo "$val" > "$STATE_DIR/animated"
    cur=$(current)
    if [ "$val" = 0 ] && [ -n "$cur" ] && [ -f "$DIR/$cur.frag" ] && is_animated "$DIR/$cur.frag"; then turn_off; fi ;;
  gpu) gpu ;;
  status) current | grep . || echo off ;;
  off) turn_off ;;
  on|set) set_shader "$2" ;;
  toggle) if [ -n "$(current)" ]; then turn_off; else set_shader "${2:-vignette}"; fi ;;
  next) step 1 "$2" ;;
  prev) step -1 "$2" ;;
  reapply) cur=$(current); [ -n "$cur" ] && [ -f "$DIR/$cur.frag" ] && apply "$DIR/$cur.frag" ;;
  *) sed -n 2,5p "$0" | sed 's/^# \?//' >&2; exit 1 ;;
esac
