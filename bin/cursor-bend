#!/usr/bin/env python3
"""cursor-bend: runs the cursor-bend shader chosen with `omashaders mouse set NAME` (cursor-shaders/NAME.frag).

Hyprland gives a screen shader no pointer position, so this helper writes the position into the shader as
constants and hands Hyprland a new file, at most ~30 times a second and only while the pointer moves (plus the
effect's `// tail: N` seconds). The effect and colour layers are merged in. Exits with its parent (the shell) or
when the mouse state is no longer a bend effect, and then puts the normal screen shader back.
"""
import glob, importlib.machinery, importlib.util, json, os, re, signal, socket, subprocess, sys, time

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "omarchy", "io.github.akton1.omashaders")
BUILT = os.path.join(STATE, "built")
PIDFILE = os.path.join(STATE, "bend.pid")
MAX_RATE = 30.0
TRAIL_N = 8
TRAIL_STEP = 0.035
POLL = 1 / 60.0

_l = importlib.machinery.SourceFileLoader("compose_shader", os.path.join(ROOT, "bin", "compose-shader"))
_s = importlib.util.spec_from_loader("compose_shader", _l)
cs = importlib.util.module_from_spec(_s)
_l.exec_module(cs)

rt = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
SOCK = "%s/hypr/%s/.socket.sock" % (rt, sig)
if not sig or not os.path.exists(SOCK):
    socks = sorted(glob.glob("%s/hypr/*/.socket.sock" % rt), key=os.path.getmtime)
    if not socks:
        sys.exit(1)
    SOCK = socks[-1]


def hypr(cmd):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(1.0)
    s.connect(SOCK)
    s.sendall(cmd.encode())
    data = b""
    while True:
        b = s.recv(65536)
        if not b:
            break
        data += b
    s.close()
    return data.decode()


def read(name):
    try:
        return open(os.path.join(STATE, name)).read().strip()
    except OSError:
        return ""


def header(path, key, default=""):
    m = re.search(r'^//\s*%s:\s*(.*)$' % key, open(path).read(), re.M)
    return m.group(1).strip() if m else default


def is_animated(path):
    return re.search(r'uniform\s+float\s+time\b', open(path).read()) is not None


def hypr_apply(path, animated):
    lua = "hl.config({debug={damage_tracking=%d}, decoration={screen_shader='%s'}})" % (0 if animated else 2, path)
    hypr("/eval " + lua)


def monitors():
    out = []
    for m in json.loads(hypr("j/monitors")):
        sc = m.get("scale", 1) or 1
        out.append((m["x"], m["y"], m["width"] / sc, m["height"] / sc, sc))
    return out


def layer_path(kind, name):
    """shaders/ or colors/ file of an effect (kind effect|color); ids starting with ai- live in the state folder (bin/aigen)"""
    if name.startswith("ai-"):
        return os.path.join(STATE, "generated", "screen" if kind == "effect" else "color", name + ".frag")
    return os.path.join(ROOT, "shaders" if kind == "effect" else "colors", name + ".frag")


def second_layer(kind, primary):
    """(path, percent, mode, mix) of the second effect/colour mixed into the first one (bin/omashaders mix ...), or None."""
    name = read(kind + "2")
    if not primary or not name or name == primary:
        return None
    path = layer_path(kind, name)
    if kind == "color" and cs.CUSTOM_RE.match(name):
        path = cs.custom_file(STATE, name)
    if not os.path.isfile(path):
        return None
    parts = (read("mix-" + kind) or "stack 100").split()
    mode = parts[0] if parts and parts[0] in ("stack", "blend") else "stack"
    try:
        val = max(0, min(100, int(parts[1])))
    except (IndexError, ValueError):
        val = 100
    pct = val
    if mode == "blend":
        pct = read("strengths/%s-%s" % ("fx" if kind == "effect" else "col", name)) or header(path, "strength", "100")
    return (path, pct, mode, val)


class Template:
    """The composed shader for the current effect + colour + bend layers, with a cursor-constants slot."""

    def __init__(self):
        self.key = None
        self.pre = self.post = ""
        self.animated = False
        self.tail = 0.0

    def refresh(self):
        name = read("mouse")
        cur = os.path.join(ROOT, "cursor-shaders", name + ".frag")
        if not name or not os.path.isfile(cur):
            return False
        fx, col = read("current"), read("color")
        fxp = layer_path("effect", fx)
        colp = layer_path("color", col)
        if cs.CUSTOM_RE.match(col):
            colp = cs.custom_file(STATE, col)
        if not os.path.isfile(fxp):
            fx = ""
        if not os.path.isfile(colp):
            col = ""
        paused = bool(read("disabled"))
        try:
            bs = max(0, min(100, int(read("strength-mouse") or "100")))
        except ValueError:
            bs = 100
        fx2 = second_layer("effect", fx)
        col2 = second_layer("color", col)
        skip = cs.parse_skip(read("fs-paused")) if read("pause-fullscreen") else None
        key = (name, fx, col, read("strength-effect"), read("strength-color"), bs, paused, fx2, col2, skip)
        if key == self.key:
            return True
        self.key = key
        fxl = (fxp, read("strength-effect") or "100") if fx and not paused else None
        coll = (colp, read("strength-color") or "100") if col and not paused else None
        text = cs.compose(fxl, coll, (cur, bs), fx2=fx2, col2=col2, skip=skip)
        self.pre, _, self.post = text.partition(cs.CUR_MARK + "\n" + cs.CUR_DEFAULTS)
        self.animated = bool(fxl) and (is_animated(fxp) or bool(fx2 and is_animated(fx2[0])))
        try:
            self.tail = float(header(cur, "tail", "0"))
        except ValueError:
            self.tail = 0.0
        return True

    def render(self, x, y, vx, vy, t, marked, trail):
        consts = "const vec2 CUR = vec2(%.1f, %.1f);\nconst vec2 CVEL = vec2(%.1f, %.1f);\nconst float CT = %.3f;\nconst bool CMARK = %s;\nconst vec2 CTR[8] = vec2[8](%s);" % (
            x, y, vx, vy, t, "true" if marked else "false", ", ".join("vec2(%.1f, %.1f)" % q for q in trail))
        return self.pre + consts + self.post


def main():
    for sg in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sg, lambda *_: sys.exit(0))
    os.makedirs(BUILT, exist_ok=True)
    open(PIDFILE, "w").write(str(os.getpid()))
    parent = os.getppid()
    tpl = Template()
    seq = int(time.time()) % 100000 * 100
    written = []
    last_pos = None
    last_move = 0.0
    last_write = 0.0
    vx = vy = 0.0
    last_t = time.time()
    last_state_check = 0.0
    state_dirty = True
    settled = False
    mons = monitors()
    last_mon_refresh = time.time()
    shown_key = None
    hist = []
    last_hist = 0.0

    def write(x, y, ct, marked, trail):
        nonlocal seq
        seq += 1
        path = os.path.join(BUILT, "bend-%d.frag" % seq)
        with open(path, "w") as f:
            f.write(tpl.render(x, y, vx, vy, ct, marked, trail))
        hypr_apply(path, tpl.animated)
        written.append(path)
        while len(written) > 6:
            try:
                os.remove(written.pop(0))
            except OSError:
                pass

    try:
        while os.getppid() == parent:
            now = time.time()
            if now - last_state_check > 0.2:
                last_state_check = now
                before = tpl.key
                if not tpl.refresh():
                    break
                if tpl.key != before:
                    state_dirty = True
            if now - last_mon_refresh > 5:
                last_mon_refresh = now
                try:
                    mons = monitors()
                except (OSError, ValueError):
                    pass
            try:
                p = json.loads(hypr("j/cursorpos"))
                pos = (p["x"], p["y"])
            except (OSError, ValueError, KeyError):
                time.sleep(POLL)
                continue
            dt = max(now - last_t, 1e-3)
            last_t = now
            moved = last_pos is not None and pos != last_pos
            if moved:
                nx = (pos[0] - last_pos[0]) / dt
                ny = (pos[1] - last_pos[1]) / dt
                vx, vy = 0.5 * vx + 0.5 * nx, 0.5 * vy + 0.5 * ny
                last_move = now
                settled = False
            elif now - last_move > 0.08:
                vx, vy = 0.6 * vx, 0.6 * vy
            last_pos = pos
            if not hist:
                hist = [pos] * TRAIL_N
            elif now - last_hist >= TRAIL_STEP:
                last_hist = now
                hist = [pos] + hist[:TRAIL_N - 1]
            ct = min(now - last_move, 99.0) if last_move else 99.0
            active = moved or (ct < tpl.tail) or state_dirty or not settled
            mon = None
            for m in mons:
                if m[0] <= pos[0] < m[0] + m[2] and m[1] <= pos[1] < m[1] + m[3]:
                    mon = m
            if active and mon and now - last_write >= 1 / MAX_RATE:
                lx, ly = (pos[0] - mon[0]) * mon[4], (pos[1] - mon[1]) * mon[4]
                trail = [((q[0] - mon[0]) * mon[4], (q[1] - mon[1]) * mon[4]) for q in hist]
                if ct >= tpl.tail and not moved:
                    ct, settled = 99.0, True
                    vx = vy = 0.0
                    trail = [(lx, ly)] * TRAIL_N
                write(lx, ly, ct, len(mons) > 1, trail)
                last_write = now
                state_dirty = False
            time.sleep(POLL)
    finally:
        try:
            os.remove(PIDFILE)
        except OSError:
            pass
        subprocess.run([os.path.join(ROOT, "bin", "omashaders"), "reapply-force"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for path in written:
            try:
                os.remove(path)
            except OSError:
                pass


if __name__ == "__main__":
    main()
