#!/usr/bin/env python3
"""shader-preview IN.png SHADER.frag OUT.png [TIME]

Render a Hyprland screen shader (GLSL ES 3.00) over an image on the CPU (Mesa llvmpipe, surfaceless EGL),
without touching the live desktop. Needs python-pillow and Mesa. Prints compile errors.
Qt-style test twins (a fragment shader that reads qt_TexCoord0, as bin/aigen builds them for wallpaper and cursor effects) get
the same vertex coordinates, the picture also as `src`, the wallpaper palette and the usual uniforms with test values;
any uniform can be set with U_name=a,b,c; SP_ALPHA=1 keeps the alpha channel in the output PNG (cursor overlays).
Window shaders (#version 320 es, from compose-shader --window) get the HyprWindowShade uniforms with test values
(surface_size = image size, is_active 1, seed 0.37, mouse = image centre, window_box = the whole image at 100,100);
override one with an environment variable, e.g. U_is_active=0 U_mouse=300,200 U_seed=0.8.
"""
import ctypes as C, os, sys

os.environ.setdefault("__EGL_VENDOR_LIBRARY_FILENAMES", "/usr/share/glvnd/egl_vendor.d/50_mesa.json")
os.environ.setdefault("LIBGL_ALWAYS_SOFTWARE", "1")
from PIL import Image

img_path, frag_path, out_path = sys.argv[1:4]
t = float(sys.argv[4]) if len(sys.argv) > 4 else 1.5
img = Image.open(img_path).convert("RGBA")
W, H = img.size

egl = C.CDLL("libEGL.so.1")
gl = C.CDLL("libGLESv2.so.2")
egl.eglGetPlatformDisplay.restype = C.c_void_p
egl.eglGetPlatformDisplay.argtypes = [C.c_uint, C.c_void_p, C.c_void_p]
egl.eglInitialize.argtypes = [C.c_void_p, C.c_void_p, C.c_void_p]
egl.eglChooseConfig.argtypes = [C.c_void_p, C.c_void_p, C.c_void_p, C.c_int, C.c_void_p]
egl.eglCreateContext.restype = C.c_void_p
egl.eglCreateContext.argtypes = [C.c_void_p, C.c_void_p, C.c_void_p, C.c_void_p]
egl.eglMakeCurrent.argtypes = [C.c_void_p, C.c_void_p, C.c_void_p, C.c_void_p]
egl.eglBindAPI.argtypes = [C.c_uint]

dpy = egl.eglGetPlatformDisplay(0x31DD, None, None)  # EGL_PLATFORM_SURFACELESS_MESA
maj, mnr = C.c_int(), C.c_int()
if not dpy or not egl.eglInitialize(dpy, C.byref(maj), C.byref(mnr)):
    sys.exit("EGL init failed")
egl.eglBindAPI(0x30A0)  # OpenGL ES
cfg = C.c_void_p()
n = C.c_int()
egl.eglChooseConfig(dpy, None, C.byref(cfg), 1, C.byref(n))
ctx_attr = (C.c_int * 3)(0x3098, 3, 0x3038)
ctx = egl.eglCreateContext(dpy, cfg, None, ctx_attr)
if not ctx or not egl.eglMakeCurrent(dpy, None, None, ctx):
    sys.exit("EGL context failed")

gl.glCreateShader.restype = C.c_uint
gl.glCreateProgram.restype = C.c_uint
gl.glGetUniformLocation.restype = C.c_int
gl.glGetUniformLocation.argtypes = [C.c_uint, C.c_char_p]
gl.glUniform1f.argtypes = [C.c_int, C.c_float]
gl.glUniform1i.argtypes = [C.c_int, C.c_int]


def compile_shader(kind, src):
    s = gl.glCreateShader(kind)
    b = C.c_char_p(src.encode())
    gl.glShaderSource(s, 1, C.byref(b), None)
    gl.glCompileShader(s)
    ok = C.c_int()
    gl.glGetShaderiv(s, 0x8B81, C.byref(ok))
    if not ok.value:
        buf = C.create_string_buffer(4096)
        gl.glGetShaderInfoLog(s, 4096, None, buf)
        sys.exit("shader compile error:\n" + buf.value.decode())
    return s


VS = """#version 300 es
out vec2 v_texcoord;
out vec2 qt_TexCoord0;
void main() {
    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
    v_texcoord = vec2(p.x, 1.0 - p.y);
    qt_TexCoord0 = v_texcoord;
    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}"""
prog = gl.glCreateProgram()
FS = open(frag_path).read()
if FS.lstrip().startswith("#version 320 es"):
    VS = VS.replace("#version 300 es", "#version 320 es")
gl.glAttachShader(prog, compile_shader(0x8B31, VS))
gl.glAttachShader(prog, compile_shader(0x8B30, FS))
gl.glLinkProgram(prog)
ok = C.c_int()
gl.glGetProgramiv(prog, 0x8B82, C.byref(ok))
if not ok.value:
    sys.exit("link failed")
gl.glUseProgram(prog)

tex = C.c_uint()
gl.glGenTextures(1, C.byref(tex))
gl.glBindTexture(0x0DE1, tex)
gl.glTexImage2D(0x0DE1, 0, 0x1908, W, H, 0, 0x1908, 0x1401, img.tobytes())
for pname, val in ((0x2800, 0x2601), (0x2801, 0x2601), (0x2802, 0x812F), (0x2803, 0x812F)):
    gl.glTexParameteri(0x0DE1, pname, val)
gl.glUniform1i(gl.glGetUniformLocation(prog, b"tex"), 0)
gl.glUniform1i(gl.glGetUniformLocation(prog, b"src"), 0)
loc = gl.glGetUniformLocation(prog, b"time")
if loc >= 0:
    gl.glUniform1f(loc, t)

PU = {"surface_size": (W, H), "is_active": (1.0,), "is_floating": (0.0,), "is_fullscreen": (0.0,), "seed": (0.37,),
      "mouse": (100 + W / 2, 100 + H / 2), "window_box": (100, 100, W, H), "resolution": (1920, 1080), "velocity": (0.0, 0.0), "is_moving": (0.0,),
      "res": (W, H), "imgSize": (W, H), "react": (1.0,), "range": (0.5,), "zoom": (1.0,),
      "cBg": (0.02, 0.01, 0.09, 1.0), "cBlue": (0.48, 0.55, 1.0, 1.0), "cMagenta": (0.85, 0.44, 0.94, 1.0), "cPink": (0.96, 0.42, 0.56, 1.0),
      "cCream": (0.98, 0.94, 0.75, 1.0), "cTarget": (0.91, 0.64, 0.24, 1.0)}
for k in ("h0", "h1", "h2", "h3"):  # cursor trail: pointer history, default all at the pointer
    PU[k] = (100 + W / 2, 100 + H / 2, 100 + W / 2, 100 + H / 2)
gl.glUniform2f.argtypes = [C.c_int, C.c_float, C.c_float]
gl.glUniform3f.argtypes = [C.c_int, C.c_float, C.c_float, C.c_float]
gl.glUniform4f.argtypes = [C.c_int, C.c_float, C.c_float, C.c_float, C.c_float]
for k, v in os.environ.items():  # U_name=... for uniforms that are not listed above
    if k.startswith("U_") and k[2:] not in PU and k[2:] != "time":
        PU[k[2:]] = tuple(float(x) for x in v.split(","))
for name, dflt in PU.items():
    loc = gl.glGetUniformLocation(prog, name.encode())
    if loc < 0:
        continue
    v = [float(x) for x in os.environ.get("U_" + name, ",".join(map(str, dflt))).split(",")]
    {1: gl.glUniform1f, 2: gl.glUniform2f, 3: gl.glUniform3f, 4: gl.glUniform4f}[len(v)](loc, *v)

fbtex, fbo = C.c_uint(), C.c_uint()
gl.glGenTextures(1, C.byref(fbtex))
gl.glActiveTexture(0x84C1)
gl.glBindTexture(0x0DE1, fbtex)
gl.glTexImage2D(0x0DE1, 0, 0x1908, W, H, 0, 0x1908, 0x1401, None)
gl.glActiveTexture(0x84C0)
gl.glGenFramebuffers(1, C.byref(fbo))
gl.glBindFramebuffer(0x8D40, fbo)
gl.glFramebufferTexture2D(0x8D40, 0x8CE0, 0x0DE1, fbtex, 0)
gl.glViewport(0, 0, W, H)
vao = C.c_uint()
gl.glGenVertexArrays(1, C.byref(vao))
gl.glBindVertexArray(vao)
gl.glDrawArrays(0x0004, 0, 3)
buf = (C.c_ubyte * (W * H * 4))()
gl.glReadPixels(0, 0, W, H, 0x1908, 0x1401, buf)
out = Image.frombytes("RGBA", (W, H), bytes(buf)).transpose(Image.FLIP_TOP_BOTTOM)
out.save(out_path) if os.environ.get("SP_ALPHA") else out.convert("RGB").save(out_path)
