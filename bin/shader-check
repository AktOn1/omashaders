#!/usr/bin/env bash
# shader-check [FILE.frag ...]: compose each shader (and colours) the way the plugin does and run glslangValidator on it
R=$(cd "$(dirname "$0")/.." && pwd); T=$(mktemp -d); rc=0
[ $# -gt 0 ] || set -- "$R"/shaders/*.frag "$R"/colors/*.frag
for f in "$@"; do
  case "$f" in */colors/*) k=--col;; *) k=--fx;; esac
  python3 "$R/bin/compose-shader" "$T/c.frag" $k "$f" 50 && out=$(glslangValidator -S frag "$T/c.frag" 2>&1) || { echo "FAIL $f"; echo "$out" | head -8; rc=1; continue; }
  grep -q '^ERROR' <<<"$out" && { echo "FAIL $f"; echo "$out" | head -8; rc=1; }
  grep -q '^\s*// \(category\|desc\):' "$f" || { echo "FAIL $f: missing category/desc header"; rc=1; }
done
rm -rf "$T"; [ $rc = 0 ] && echo "all shaders ok"; exit $rc
