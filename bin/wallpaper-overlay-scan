#!/usr/bin/env python3
"""wallpaper-overlay-scan PIC1 [PIC2 ...] > wallpaper-effects/overlay.tsv : renders every wallpaper effect over the pictures
and measures how much of the picture survives at full strength. Needs a Python venv with moderngl, pillow and numpy.
Output: id<TAB>mean change 0-100<TAB>% of pixels changed a lot<TAB>overlay|scene.
(framebuffer rows are read bottom-up, so they are flipped before comparing with the picture)
overlay = the picture stays the picture (light touches on top); scene = the effect repaints most of it."""
import sys, os, glob, struct, moderngl, numpy as np
from PIL import Image
HERE = os.path.dirname(os.path.abspath(__file__))
W, H = 480, 270
TIMES = (7.0, 23.0)
MEAN_MAX, FRAC_MAX = 20.0, 40.0
# by eye (contact sheets): these keep most of the picture's pixels but still paint a landscape or heavy shapes over it (paint) or bend/warp/pixelate it (warp)
NOT_LIGHT = {"dunes": "paint", "lavenderfields": "paint", "mistpines": "paint", "cloudscape": "paint", "caustics": "paint", "droplets": "paint",
             "chroma": "warp", "kaleido": "warp", "blackhole": "warp", "pixel": "warp", "glitch": "warp", "vhs": "warp", "grid": "warp",
             "xray": "warp", "shock": "warp", "lens": "warp", "liquid": "warp",
             "aquarelle-wash": "paint", "auroralake": "paint", "librarybeams": "paint", "ega-desk": "warp"}
ONLY = set(os.environ.get("ONLY", "").split(",")) - {""}  # env ONLY=a,b limits the scan to those effects
ctx = moderngl.create_standalone_context(backend="egl", require=440)
vs = "#version 440\nlayout(location=0) in vec2 p; layout(location=0) out vec2 qt_TexCoord0; void main(){ qt_TexCoord0=vec2(p.x*0.5+0.5, 0.5-p.y*0.5); gl_Position=vec4(p,0,1);}"
vbo = ctx.buffer(np.array([-1, -1, 1, -1, -1, 1, 1, 1], dtype="f4").tobytes())
fbo = ctx.simple_framebuffer((W, H), components=4)
def col(h): return [int(h[i:i + 2], 16) / 255 for i in (1, 3, 5)] + [1.0]
cols = [col(c) for c in ("#050318", "#7a8cff", "#da6fef", "#f56c90", "#FAF0BF")]
SPR = None  # sprite atlas of the effect being measured (binding 2)
def render(prog, vao, tex, iw, ih, t):
    data = np.eye(4, dtype="f4").tobytes() + struct.pack("ffffffff", 1.0, t, 0.5 * W, 0.5 * H, W, H, iw, ih)
    data += b"".join(struct.pack("4f", *c) for c in cols)
    data += struct.pack("4f", *col("#e8a33d")) + struct.pack("4f", 1.0, 0.5, 1.0, 0.0) + struct.pack("3f", 0, 0, 0) + bytes(52)
    ub = ctx.buffer(data); ub.bind_to_uniform_block(0)
    tex.use(1)
    if SPR: SPR.use(2)
    fbo.use(); fbo.clear(0, 0, 0, 1); vao.render(moderngl.TRIANGLE_STRIP)
    return np.frombuffer(fbo.read(components=4), dtype=np.uint8).reshape(H, W, 4)[::-1, :, :3].astype(np.float32) / 255
pics = []
for p in sys.argv[1:]:
    im = Image.open(p).convert("RGB"); iw, ih = im.size
    tex = ctx.texture((iw, ih), 3, im.tobytes()); tex.build_mipmaps(); tex.filter = (moderngl.LINEAR_MIPMAP_LINEAR, moderngl.LINEAR)
    ref = np.asarray(im.resize((W, H), Image.LANCZOS), dtype=np.float32) / 255
    pics.append((tex, iw, ih, ref))
for f in sorted(glob.glob(os.path.join(HERE, "..", "wallpaper-effects", "*.frag"))):
    n = os.path.basename(f)[:-5]
    if ONLY and n not in ONLY:
        continue
    try:
        prog = ctx.program(vertex_shader=vs, fragment_shader=open(f).read())
        vao = ctx.vertex_array(prog, [(vbo, "2f", "p")])
    except Exception as e:
        print("skip %s: %s" % (n, str(e)[:80]), file=sys.stderr); continue
    SPR = None
    if os.path.exists(f[:-5] + ".png"):
        si = Image.open(f[:-5] + ".png").convert("RGBA")
        SPR = ctx.texture(si.size, 4, si.tobytes()); SPR.build_mipmaps(); SPR.filter = (moderngl.LINEAR_MIPMAP_LINEAR, moderngl.LINEAR)
    means, fracs = [], []
    for tex, iw, ih, ref in pics:
        for t in TIMES:
            d = np.abs(render(prog, vao, tex, iw, ih, t) - ref).mean(axis=2)
            means.append(d.mean() * 100); fracs.append((d > 0.2).mean() * 100)
    m, fr = max(means), max(fracs)
    print("%s\t%.1f\t%.1f\t%s" % (n, m, fr, "overlay" if m <= MEAN_MAX and fr <= FRAC_MAX and n not in NOT_LIGHT else "scene"))
