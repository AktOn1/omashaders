#!/usr/bin/env python3
"""wallpaper-preview WALL.png OUT.png MX,MY T1,T2 effect.frag ... : contact sheet (rows = effects, columns = times). Needs a venv with moderngl, pillow, numpy (env ZOOM=1 SPEED=1 AUDIO=level,bass,mid,treble for the zoom and speed sliders, TARGET=#rrggbb REACT=1 RANGE=0.5 to set the colour-reactor target, mouse reaction 0..2 and range 0..1; the python packages moderngl, pillow and numpy in a venv)."""
import sys, os, struct, moderngl, numpy as np
AUDIO = (list(map(float, os.environ.get('AUDIO', '0,0,0,0').split(','))) + [0, 0, 0, 0])[:4]  # level,bass,mid,treble for audio-* effects
from PIL import Image
# render.py wall.png out.png mx,my t1,t2,... effect1.frag effect2.frag ...  -> contact sheet (rows=effects, cols=times)
wall, out, mouse, times = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
files = sys.argv[5:]
W, H = 960, 540
mx, my = [float(v) for v in mouse.split(",")]
ts = [float(v) for v in times.split(",")]
ctx = moderngl.create_standalone_context(backend='egl', require=440)
img = Image.open(wall).convert("RGB"); iw, ih = img.size
tex = ctx.texture((iw, ih), 3, img.tobytes()); tex.build_mipmaps(); tex.filter=(moderngl.LINEAR_MIPMAP_LINEAR, moderngl.LINEAR)
ZOOM = float(os.environ.get("ZOOM", "1")); SPEED = float(os.environ.get("SPEED", "1"))
vs = "#version 440\nlayout(location=0) in vec2 p; layout(location=0) out vec2 qt_TexCoord0; void main(){ qt_TexCoord0=(vec2(p.x*0.5+0.5, 0.5-p.y*0.5)-0.5)/"+str(ZOOM)+"+0.5; gl_Position=vec4(p,0,1);}"
vbo = ctx.buffer(np.array([-1,-1,1,-1,-1,1,1,1],dtype='f4').tobytes())
fbo = ctx.simple_framebuffer((W, H), components=4)
def col(h): return [int(h[i:i+2],16)/255 for i in (1,3,5)]+[1.0]
cols = [col(c) for c in ("#050318","#7a8cff","#da6fef","#f56c90","#FAF0BF")]
sheet = Image.new("RGB", (W*len(ts)//2, H*len(files)//2))
for r, f in enumerate(files):
    prog = ctx.program(vertex_shader=vs, fragment_shader=open(f).read())
    vao = ctx.vertex_array(prog, [(vbo, '2f', 'p')])
    for c, t in enumerate(ts):
        mat = np.eye(4, dtype='f4')
        data = mat.tobytes() + struct.pack('ffffffff', 1.0, t*SPEED, ((mx-0.5)/ZOOM+0.5)*W, ((my-0.5)/ZOOM+0.5)*H, W, H, iw, ih)
        data += b''.join(struct.pack('4f', *cc) for cc in cols)
        data += struct.pack('4f', *col(os.environ.get("TARGET", "#e8a33d"))) + struct.pack('4f', float(os.environ.get("REACT", "1")), float(os.environ.get("RANGE", "0.5")), ZOOM, AUDIO[0]) + struct.pack('3f', *AUDIO[1:]) + bytes(52)
        ub = ctx.buffer(data); ub.bind_to_uniform_block(0)
        tex.use(1); fbo.use(); fbo.clear(0,0,0,1); vao.render(moderngl.TRIANGLE_STRIP)
        im = Image.frombytes("RGBA", (W,H), fbo.read(components=4)).transpose(Image.FLIP_TOP_BOTTOM).convert("RGB").resize((W//2,H//2))
        sheet.paste(im, (c*W//2, r*H//2))
sheet.save(out); print("ok", out)
