#!/usr/bin/env python3
"""The scripted terminal session shown in the share GIF (run inside the demo terminal by bin/gif-capture).

  gif-demo --go FLAG --state DIR [--name THEME] [--plain] [--flavour FILE]

The session is the same on every machine: an empty prompt with a blinking cursor, then (once FLAG exists, which the
recorder creates when the recording starts) `omashaders theme apply NAME` is typed, its answer lists the look's parts,
a second command follows. Timing is 12 steps per second, like the preview GIFs this look comes from.
"""
import argparse, json, os, re, sys, time

FPS, CPF = 12, 2  # steps per second, characters typed per step
T_BLANK = 5
FG, DIM, GREEN, OUT2, CURSOR = (232, 240, 255), (150, 175, 205), (126, 231, 135), (150, 220, 255), (140, 215, 235)
PARTS = [  # label, state file, strength file, icon, plain icon, colour
    ("screen", "current", "strength-effect", "\U000f01c4", "#", (127, 214, 255)),
    ("colour", "color", "strength-color", "\U000f03d8", "#", (199, 146, 234)),
    ("wallpaper", "wp-effect", "strength-wall", "\U000f02e9", "#", (94, 234, 212)),
    ("cursor", "mouse", "strength-mouse", "\U000f037d", "#", (154, 215, 255)),
]


# Second command of the session: a made-up, tongue-in-cheek command that someone who knows the theme's topic would
# smile at, answered by a one-line read-out. The AI the theme creator uses writes it (`--prepare`, run by gif-capture
# before the recording and stored in the --flavour file); with no AI, or when it fails, the command is a real-looking
# tool pointed at one word of the name, answered in name words, moods and effects.
STOP = {"the", "a", "an", "of", "and", "my", "night", "hour", "calm", "light", "glow", "soft", "new"}


GENERIC = {"my", "theme", "look", "untitled", "new", "custom", "copy"}
CMDS = [  # real tools pointed at one word of the name
    "tail -f /var/log/{w}.log", "systemctl status {w}", "systemctl --user start {w}", "journalctl -u {w} -n 5",
    "watch -n 5 cat /proc/{w}", "cat /etc/{w}.conf | less",
]
MOODS = [
    "humming", "unreasonably cosy", "dangerously calm", "fully charged", "mildly smug", "on fire (the good kind)",
    "perfectly fine", "suspiciously quiet", "extra crispy", "slightly haunted", "loaded", "dreaming", "in the zone",
    "buffering", "very much alive", "plotting something", "ready", "unbothered",
]


def hashed(text):
    return sum((i + 1) * ord(c) for i, c in enumerate(text))


def made_up(name, rows):
    """A real-looking command around one word of the name (or the effect names), answered in name words and effects."""
    effects = [(re.sub(r"[^a-z0-9]+", " ", r[1].lower()).strip(), r[2]) for r in rows][:3]
    words = [w for w in re.findall(r"[a-z0-9]+", name.lower()) if w not in STOP and w not in GENERIC and len(w) > 1]
    named = bool(words)
    if not words:
        words = [w for e, _ in effects for w in e.split() if len(w) > 2 and w not in STOP]
    if not words:
        return None, None
    seed = hashed(name.lower() + "|" + ",".join(e for e, _ in effects))
    key = (max(words, key=len) if named else words[0])[:12]
    cmd = "modprobe %s-glow" % key if not named else CMDS[seed % len(CMDS)].format(w=key)
    fields = []
    if named:
        fields = ["%s: %s" % (w, MOODS[(seed + 5 * i + 3) % len(MOODS)]) for i, w in enumerate([w for w in words if w != key][:2])]
        if not fields:
            fields.append("%s: %s" % (key, MOODS[(seed + 3) % len(MOODS)]))
    fields += [("%s %s" % (e, s)).strip() for e, s in effects if e]
    out = fields[0]
    for f in fields[1:]:
        if len(out) + 3 + len(f) > 66:
            break
        out += " · " + f
    return cmd, out


SYSTEM = "You write one joke line for a screenshot of a desktop theme. Answer with one JSON object and nothing else."
PROMPT = """A desktop theme is called "%s"%s.
Write the LAST line of a terminal demo: a made-up shell command that fits this theme's topic and makes a person who knows
that topic smile (a nerdy in-joke, a fitting tool, flag or file name). It does not have to exist. Then one line the command
prints, with a couple of made-up read-outs in the same spirit.
Rules: the command is at most 44 characters, the output at most 62, plain ASCII except the middle dot, no quotes
around the whole thing, nothing that could hurt a computer. Never write about the desktop theme itself, only the topic.
Example for a theme called Abyss: {"command": "dive --depth 4000m", "output": "4000 m \u00b7 400 atm \u00b7 light: none"}
Answer: {"command": "...", "output": "..."}"""


def clean_line(v, limit):
    v = re.sub(r"[^\x20-\x7e\u00b7\u00b0\u2013\u2014]", "", str(v or "")).strip()
    return v if 2 <= len(v) <= limit else ""


def ask_ai(name, rows):
    """-> (command, output) from the AI the theme creator uses, or None."""
    try:
        import aiprov
        ch = aiprov.choice()
        if not aiprov.availability(ch)["available"]:
            return None
        if ch["provider"] == "claude":
            ch["model"] = "haiku"
        effects = ", ".join(r[1] for r in rows)
        text, _ = aiprov.call(ch, SYSTEM, PROMPT % (name, (" (it uses the effects: %s)" % effects) if effects else ""), timeout=45)
        m = re.search(r"\{.*?\}", text, re.S)
        d = json.loads(m.group(0)) if m else {}
    except Exception:
        return None
    cmd, out = clean_line(d.get("command"), 44), clean_line(d.get("output"), 62)
    return (cmd, out) if cmd and out else None


def prepare(path, name, rows):
    hit = ask_ai(name, rows) if name else None
    with open(path, "w") as f:
        json.dump({"command": hit[0], "output": hit[1]} if hit else {}, f)
    return hit


def flavour(name, rows, path=""):
    try:
        d = json.load(open(path)) if path else {}
        if d.get("command") and d.get("output"):
            return d["command"], d["output"]
    except (OSError, ValueError, AttributeError):
        pass
    return made_up(name, rows)


def rgb(c, bold=False):
    return "\033[%s38;2;%d;%d;%dm" % ("1;" if bold else "", *c)


def read(state, name):
    try:
        return open(os.path.join(state, name)).read().strip()
    except OSError:
        return ""


def parts(state):
    rows = []
    for label, f, sf, icon, plain, col in PARTS:
        v = read(state, f)
        if v:
            s = read(state, sf)
            rows.append((label, v, (s + "%") if s.isdigit() else "", icon, plain, col))
    return rows


class Session:
    def __init__(self, name, rows, plain, flavour_file=""):
        self.name, self.rows, self.plain = name, rows, plain
        self.cmd1 = "omashaders theme apply " + (('"%s"' % name) if " " in name else name)
        self.cmd2, self.out2 = flavour(name, rows, flavour_file)
        self.t_type1 = T_BLANK
        self.t_enter1 = self.t_type1 + (len(self.cmd1) + CPF - 1) // CPF
        self.t_apply = self.t_enter1 + 3
        self.t_out1 = [self.t_apply + 3 + 3 * i for i in range(len(rows))]
        self.t_done = (self.t_out1[-1] if rows else self.t_apply) + 4
        self.t_type2 = self.t_done + 10
        self.t_enter2 = self.t_type2 + ((len(self.cmd2) + CPF - 1) // CPF if self.cmd2 else 0)
        self.t_out2 = self.t_enter2 + 4

    def prompt(self, text, cursor):
        s = rgb(DIM) + "~ " + rgb(GREEN, True) + "❯ " + "\033[0m" + rgb(FG) + text + "\033[0m"
        if cursor:
            s += "\033[48;2;%d;%d;%dm \033[0m" % CURSOR
        return s

    def frame(self, f):
        blink = (f // 3) % 2 == 0
        ic = lambda a, b: b if self.plain else a
        lines = []
        entered = f >= self.t_enter1
        lines.append((rgb(DIM) + ic("\U000f018d", ">") + " " + self.name.lower() + " — omashaders" + "\033[0m") if entered else "")
        n1 = len(self.cmd1) if entered else min(len(self.cmd1), max(0, (f - self.t_type1 + 1) * CPF))
        lines.append(self.prompt(self.cmd1[:n1], blink and not entered))
        if entered:
            if f >= self.t_apply:
                lines.append(rgb(GREEN) + ic("", "*") + " " + rgb(DIM) + 'applying theme "%s" ...' % self.name + "\033[0m")
            else:
                lines.append("")
            width = max([11] + [len(r[1]) + 2 for r in self.rows])
            for i, (label, v, s, icon, plain, col) in enumerate(self.rows):
                if f < self.t_out1[i]:
                    break
                lines.append("  " + rgb(col) + ic(icon, plain) + " " + label.ljust(10) + "\033[0m" + rgb(FG) + v.ljust(width)
                             + rgb(DIM) + s + "\033[0m")
            if f >= self.t_done:
                lines.append(rgb(GREEN) + ic("\uf00c", "v") + " " + rgb(DIM) + "done · %d layer%s applied" % (len(self.rows), "" if len(self.rows) == 1 else "s") + "\033[0m")
                if not self.cmd2:
                    lines.append(self.prompt("", blink) if f >= self.t_done + 3 else "")
                elif f < self.t_type2:
                    lines.append(self.prompt("", blink) if f >= self.t_done + 3 else "")
                else:
                    n2 = len(self.cmd2) if f >= self.t_enter2 else min(len(self.cmd2), (f - self.t_type2 + 1) * CPF)
                    lines.append(self.prompt(self.cmd2[:n2], blink and f < self.t_enter2))
                    if f >= self.t_out2:
                        lines.append("  " + rgb(OUT2) + self.out2 + "\033[0m")
                        lines.append(self.prompt("", blink and f >= self.t_out2 + 3) if f >= self.t_out2 + 3 else "")
        return "\033[H" + "\r\n".join(l + "\033[K" for l in lines) + "\033[J"


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--go", default="")
    p.add_argument("--duration", action="store_true", help="print how many seconds the session takes and exit")
    p.add_argument("--state", required=True)
    p.add_argument("--name", default="")
    p.add_argument("--plain", action="store_true")
    p.add_argument("--flavour", default="", help="JSON file with the second command (written by --prepare)")
    p.add_argument("--prepare", action="store_true", help="ask the AI for the second command, write it to --flavour and exit")
    a = p.parse_args()
    if a.prepare:
        if not a.flavour:
            p.error("--prepare needs --flavour")
        prepare(a.flavour, a.name, parts(a.state))
        return
    if a.duration:
        sess = Session(a.name or "my theme", parts(a.state), False, a.flavour)
        print("%.2f" % ((sess.t_out2 + 4) / FPS if sess.cmd2 else (sess.t_done + 4) / FPS))
        return
    if not a.go:
        p.error("--go is required")
    out = sys.stdout
    out.write("\033[?25l\033[2J\033[H")
    out.flush()
    name = a.name or "my theme"
    session = Session(name, [], a.plain, a.flavour)
    start, t0, last = time.monotonic(), None, None
    while True:
        now = time.monotonic()
        if t0 is None and os.path.exists(a.go):
            t0 = now
            session = Session(name, parts(a.state), a.plain, a.flavour)  # the look was applied after this terminal opened
        f = int((now - t0) * FPS) if t0 is not None else int((now - start) * FPS) % 6
        text = session.frame(f)
        if text != last:
            out.write(text)
            out.flush()
            last = text
        time.sleep(0.01)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
